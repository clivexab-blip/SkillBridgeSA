<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SkillBridgeSA" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/sb_navy</item>
        <item name="colorPrimaryVariant">@color/sb_navy_dark</item>
        <item name="colorOnPrimary">@color/sb_white</item>
        <item name="colorSecondary">@color/sb_green</item>
        <item name="colorSecondaryVariant">@color/sb_green_dark</item>
        <item name="colorOnSecondary">@color/sb_white</item>
        <item name="android:statusBarColor">@color/sb_navy_dark</item>
        <item name="android:windowBackground">@color/sb_bg</item>

        <!-- Component Styling for Figma Look -->
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.SkillBridge.Large</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.SkillBridge.Medium</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.SkillBridge.Small</item>
    </style>

    <style name="ShapeAppearance.SkillBridge.Large" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <style name="ShapeAppearance.SkillBridge.Medium" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.SkillBridge.Small" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="DividerStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:background">@color/sb_divider</item>
    </style>
</resources>
